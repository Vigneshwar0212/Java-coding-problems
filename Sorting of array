//sorting an string

package SampleTest;

import java.lang.reflect.Array;
import java.util.Arrays;

public class Arraylist {
	public static void main(String[] args) {
        String str = "Orange";
		char b[] = str.toCharArray();
		Arrays.sort(b);
		for (int i=0; i<b.length; i++) {
		System.out.print(b[i]);
		}
	}
}

