package SampleTest;

package SampleTest;

import java.lang.reflect.Array;
import java.util.Arrays;

public class Arraylist {
	public static void main(String[] args) {
		int a[] = {100,500,800,700,300,400,900};
		
		System.out.println("Before sorting..");
		System.out.println(Arrays.toString(a)); //used to print the array values without using the for loops for printing the values
		Arrays.sort(a);
		System.out.println("After sorting..");
		
		//instead of using any for loops we can directly use Arrays.toString(a) for printing the values
		
		/* for (int i = 0; i<a.length; i++) {
			System.out.print(a[i]+" ");
		} */
		
		//enhanced for loop
		
		/* for (int i :a) {
			System.out.print(i+" ");
		} */
		
		System.out.println(Arrays.toString(a));
	}
}

