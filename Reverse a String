// using a tocharArray() method

public class Main{
    
    public static void main(String[] args){
        String str = "abcdefgh";
        String rev = "";
        char a[] = str.toCharArray();  //convert the string to a character array
        int len = str.length();
        
        for (int i = len -1; i>=0; i--){
            rev = rev+a[i];
        }
        System.out.println("Reversed string is: "+rev);
    }
}

