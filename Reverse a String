//charAt method to reverse a string

public class Main{
    
    public static void main(String[] args){
        String str = "abcdefgh";
        String rev = "";
        
        for (int i = str.length()-1; i>=0; i--){    // i = 8-1, i=7 at the 7th index "h" is stored -> then 6th index value "g"......
            rev=rev+str.charAt(i); // rev=null -> rev= null+h, rev =h -> rev = h+g, rev =hg......
        }
        System.out.println("Entered string is: "+str);
        System.out.println("Reverse of the string is: "+rev);
        
    }
}

