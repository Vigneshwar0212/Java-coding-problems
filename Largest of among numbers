//second and third largest number finding

import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        
        int num[] = {12,5,7,5,785,47,57,58,47,58,789,5,85,775,454,78};
        Arrays.sort(num); //sort the given array to asecending order
        
        int len = num.length;   // check the length of the array
        int second = num[len-2];  // print like len = 16 -> second largest number = 16-2(2 is because we need to print the 14th index value) -> len = 14
        int third = num[len-3];  // similar to the above line as if we want to print the number usually we use num[14] - index value, same logic is applied
        
        System.out.println(Arrays.toString(num));   //print all the numbers in the array in ascending order
        System.out.println(len);
        System.out.println("Second largest number in the array is: "+second);
        System.out.println("Third largest number in the array is: "+third);
    }
}
