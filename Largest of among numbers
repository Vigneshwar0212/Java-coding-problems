//using if statement

public class Main
{
	public static void main(String[] args) {
	    int a = 100, b = 200, c = 500;
	    if(a>b && a>c){
	        System.out.println(a+" is greater");
	    }else if(b>c && b>a){
	        System.out.println(b+" is greater");
	    }else{
	        System.out.println(c+" is greater");
	    }
	    }
	
}

