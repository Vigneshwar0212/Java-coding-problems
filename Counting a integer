public class Main{
    public static void main(String[] args){
        
        int num = 1234;
        
        int count = 0;
        
        while(num>0){
            num = num/10;  
// first num will assign a value of 1234 -> num = 1234/10 -> (/ only accepts quotient value) num = 123, again num = 123/10 -> num = 12 ..so on-> finally num = 1/10, condition fails.
            count++; // every time the above code runs it increases the count value.
        }
        System.out.println("the no. of integer is: "+count);
    }
}

