//using + and - operator

public class Main
{
	public static void main(String[] args) {
	    
	    int a = 20, b = 30;
	    System.out.println("Before swapping the numbers: a= "+a+" b= "+b);
	    
	    a = a+b; //assign a value of a = a+b -> a= 20+30 = 50
	    b = a-b; //b= 50-30 = 20
	    a = a-b; //a= 50-20 = 30
	    
	    System.out.println("After swapping the numbers: a= "+a+" b= "+b);
	}
	
}

