//using * and / operators
//a and b should be a non zero numbers

public class Main
{
	public static void main(String[] args) {
	    
	    int a = 20, b = 60;
	    System.out.println("Before swapping the numbers: a= "+a+" b= "+b);
	    
	    a = a*b; //assign a value of a = a*b -> a= 20*60 = 1200
	    b = a/b; //b= 1200/60 = 20
	    a = a/b; //a= 1200/20 = 60
	    
	    System.out.println("After swapping the numbers: a= "+a+" b= "+b);
	}
	
}

