		//StringBuffer method
		// String.valueOf(num) - used to convert the data type of the value, here the integer num is being converted to String using this method.

import java.util.Scanner;

public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner (System.in);
	    System.out.print("Enter the number: ");
	    int num = sc.nextInt();
	    
	    StringBuffer sb = new StringBuffer(String.valueOf(num));
	    StringBuffer rev = sb.reverse();
	    System.out.println("Reverse of the entered number: "+rev);
	    
	}
}

