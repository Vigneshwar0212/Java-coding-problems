//== and .equals()
package Selenium_test;

public class Arraylist {
	public static void main(String[] args) {

		int a = 123;
		int b = 123;
		
		System.out.println((a==b)); //true
		//System.out.println(a.equals(b)); //error only for strings and objects
		
		String c = "hello";
		String d = "hello";
		System.out.println((c==d)); //true
		System.out.println(c.equals(d)); //true
		
		String e = new String ("Welcome");
		String f = new String ("Welcome");
		System.out.println((e==f)); //false -> it compare the objects so it returns false
		System.out.println(e.equals(f)); //true -> it compares the values of the object created so return true
		
		String g = new String("world");
		String h = "world";
		String i = g;
		System.out.println((g==h)); //false
		System.out.println((g==i)); //true -> objects are same
		System.out.println(g.equals(h)); //true
		System.out.println(g.equals(i)); //true
	}
}

