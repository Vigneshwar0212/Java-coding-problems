//Removing special characters in a string using replaceAll method
//replaceAll method
// without using ^

import java.util.ArrayList;

public class Main{
    public static void main(String[] args){
        String str = "asdgvhav asdova v 4343.43 ADBAB Afbabab !@#$^&*^%$@$%%^$<>}{+_~";
        String s = str.replaceAll("[a-zA-Z0-9 ]", ""); //by using this without ^ tells that, replace all the values mentioned in the first "", with the values of second ""
        
        System.out.println(s);
        
    }
}

