// Palindrome is a number which will be same as the original number after reversing the number. (orginal num - 12321, reverse num - 12321. It is a palindrome number)
//Number

import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int num = sc.nextInt();
        int org_num = num;
        int rev = 0;
        
        while(num>0){
            rev = rev * 10 + num % 10;
            num = num / 10;
        }
        
        if(org_num == rev){
            System.out.println(org_num+" it is a palindrome number..");
        }else{
            System.out.println(rev+" it is not a palindrome number..");
        }
    }
}

